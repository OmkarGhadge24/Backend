<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nova | Welcome</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
      }
      body {
        font-family: Arial, sans-serif;
        background: #f8f9fa;
        color: #111827;
      }
      nav {
        display: flex;
        justify-content: space-between;
        padding: 25px 8%;
      }
      nav a {
        margin-left: 25px;
        text-decoration: none;
        color: #555;
      }
      .hero {
        text-align: center;
        padding: 130px 20px;
      }
      .hero span {
        background: #e5e7eb;
        padding: 8px 15px;
        border-radius: 20px;
        font-size: 14px;
      }
      h1 {
        font-size: 55px;
        margin: 25px 0 15px;
      }
      p {
        color: #6b7280;
        font-size: 18px;
        margin-bottom: 30px;
      }
      .btn {
        padding: 12px 20px;
        border-radius: 7px;
        text-decoration: none;
        margin: 5px;
      }
      .primary {
        background: #111827;
        color: white;
      }
      .secondary {
        border: 1px solid #ddd;
        color: #333;
      }
    </style>
  </head>

  <body>
    <nav>
      <strong>Nova.</strong>
      <div>
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </div>
    </nav>
    <section class="hero">
      <span>✨ Simple. Fast. Modern.</span>
      <h1>Build something people love.</h1>
      <p>Turn your ideas into something simple, beautiful and useful.</p>
      <a href="/signup" class="btn primary">Get Started</a>
      <a href="/about" class="btn secondary">Learn More</a>
    </section>
  </body>
</html>
